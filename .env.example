# Copy this file to .env and fill in real values (then `export $(cat .env | xargs)`
# or use a tool like direnv/python-dotenv - nothing in this repo auto-loads .env).

# --- storage ---
# DEALSOURCING_DB_PATH=data/dealsourcing.db

# --- eligibility thresholds ---
# MAX_TOTAL_FUNDING_MILLION_YEN=200   # 2億円
# UNLISTED_TYPE_VALUE=未公開企業

# --- email (SendGrid) ---
EMAIL_TO=takai@genesiaventures.com
EMAIL_FROM=                # must be a sender identity verified in your SendGrid account
SENDGRID_API_KEY=          # required unless DEALSOURCING_DRY_RUN=1

# --- web research ---
# One of: google_cse (default - free tier: 100 queries/day, see
# https://developers.google.com/custom-search/v1/overview) | serpapi (paid)
SEARCH_API_PROVIDER=google_cse
SEARCH_API_KEY=            # Google CSE API key (Google Cloud Console), or SerpAPI key if using serpapi
GOOGLE_CSE_ID=             # required for google_cse - your Programmable Search Engine's cx value
# RESEARCH_MAX_RESULTS=5

# Stay within Google CSE's 100/day free quota: the builder pipeline's
# websearch_source.py issues ~1 query per config/accelerator_programs.yaml
# entry + config/builder_keywords.yaml's general_founder_prep_queries
# (~18 total as shipped) EVERY time run_builder_scan.py runs. Running it
# hourly would blow through the free quota (18 * 24 = 432/day) - a few
# times a day (e.g. every 6 hours) keeps it comfortably under 100/day
# even combined with the company pipeline's research.py usage.

# If SEARCH_API_KEY is left empty, the pipeline falls back to reading
# data/manual_research/<company_id>.txt instead of calling a search API.

# --- local Ollama ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1
# OLLAMA_TIMEOUT_SECONDS=180

# --- misc ---
# Set to 1 to print the email instead of sending it (no SendGrid account needed).
DEALSOURCING_DRY_RUN=0

# --- builder-sourcing pipeline (run_builder_scan.py - separate from the above) ---
# GitHub personal access token (no special scopes needed, just avoids the
# ~10 req/min unauthenticated search rate limit). Without it, github_source
# is skipped entirely.
GITHUB_TOKEN=
# Qiita API v2 token - optional, raises the rate limit from 60/hour to
# 1000/hour. qiita_source works without it, just slower.
QIITA_TOKEN=
# Minimum total_score (see config/builder_scoring_prompt.txt, 100pt scale)
# to trigger an immediate alert email.
BUILDER_SCORE_THRESHOLD=70
# Recipient for builder alerts. Defaults to EMAIL_TO if unset.
BUILDER_EMAIL_TO=
# Reuses SENDGRID_API_KEY/EMAIL_FROM/DEALSOURCING_DRY_RUN above - no
# separate email config needed.
# Reuses SEARCH_API_KEY/SEARCH_API_PROVIDER/GOOGLE_CSE_ID above for
# websearch_source.py (accelerator/Wantedly/researchmap/general queries).
# connpass's API needs no key.
